# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Automatic Real Email Delivery (Pick ONE option below in Settings > Secrets)
# Option 1 (Easiest Free Setup with Gmail):
# GMAIL_USER="arledigt@gmail.com"
# GMAIL_APP_PASSWORD="your-16-char-google-app-password"
# Option 2: Resend API (recommended for custom domains on Cloud Run)
# RESEND_API_KEY=""
# ALERT_FROM_EMAIL="BINAH CARE Alerts <onboarding@resend.dev>"
# Option 3: Custom SMTP Server
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""

# Automatic Real Text (SMS) Delivery via Twilio
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+18455550100"
# ADMIN_ALERT_PHONE="+18455550199"

# Optional Custom Webhook URL (Zapier / Make / n8n Email & SMS Relay)
# ADMIN_ALERT_WEBHOOK_URL=""


